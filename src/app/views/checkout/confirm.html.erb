<div class="app-container-normal">
  <h2 class="app-h2">購入確認</h2>

  <%= form_with url: checkout_path, method: :post do |form| %>
    <div>
      <%= render "list" %>
    </div>

    <div class="mt-10">
      <%= render "addresses", form: form %>
    </div>

    <div class="mt-10">
      <%= form.label :payment_method, class: "app-form-label" %>
      <%= form.select :payment_method, UserOrder.active_payment_methods.invert %>
    </div>

    <div class="mt-10">
      <%= render "summary", form: form %>
    </div>
  <% end %>
</div>
