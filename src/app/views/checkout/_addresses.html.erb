<div class="space-y-5">
  <% @user_addresses.each_with_index do |user_address, index| %>
    <div class="border p-5">
      <div>
        <%= form.radio_button :user_address_id, user_address.id, checked: user_address.id == @user_order.user_address_id, class: "w-4 h-4 text-blue-600" %>
      </div>
      <div>
        <%= user_address.postal_code %>
        <%= user_address.prefecture_text %>
        <%= user_address.city %>
        <%= user_address.address_line1 %>
        <%= user_address.address_line2 %>
        <%= user_address.phone_number %>
      </div>
    </div>
  <% end %>
</div>