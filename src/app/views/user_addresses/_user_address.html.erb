<div id="<%= dom_id user_address %>">
  <p>
    <strong>User:</strong>
    <%= user_address.user_id %>
  </p>

  <p>
    <strong>Postal code:</strong>
    <%= user_address.postal_code %>
  </p>

  <p>
    <strong>Prefecture:</strong>
    <%= user_address.prefecture %>
  </p>

  <p>
    <strong>City:</strong>
    <%= user_address.city %>
  </p>

  <p>
    <strong>Address line1:</strong>
    <%= user_address.address_line1 %>
  </p>

  <p>
    <strong>Address line2:</strong>
    <%= user_address.address_line2 %>
  </p>

  <p>
    <strong>Phone number:</strong>
    <%= user_address.phone_number %>
  </p>

</div>
