<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <div class="divide-y divide-gray-100">
    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-semibold text-gray-500">Postal code</div>
      <div class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= user_address.postal_code %></div>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-semibold text-gray-500">Prefecture</div>
      <div class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= user_address.prefecture %></div>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-semibold text-gray-500">City</div>
      <div class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= user_address.city %></div>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-semibold text-gray-500">Address line1</div>
      <div class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= user_address.address_line1 %></div>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-semibold text-gray-500">Address line2</div>
      <div class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= user_address.address_line2 %></div>
    </div>

    <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-semibold text-gray-500">Phone number</div>
      <div class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= user_address.phone_number %></div>
    </div>
  </div>
</div>