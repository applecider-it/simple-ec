<%= form_with(model: user_address) do |form| %>
  <%= render "shared/message/error_messages", resource: user_address %>

  <div class="space-y-3">
    <div>
      <%= form.label :postal_code, class: "block" %>
      <%= form.text_field :postal_code, class: "app-form-input w-32" %>

      <button data-app-element-postal-code="<%= {
        postal_code: "user_address_postal_code",
        prefecture: "user_address_prefecture",
        city: "user_address_city",
        address_line1: "user_address_address_line1",
      }.to_json %>" type="button" class="app-btn-secondary">郵便番号検索</button>
    </div>

    <div>
      <%= form.label :prefecture, class: "block" %>
      <%= form.select :prefecture, I18n.t('app.data.prefectures').invert, { include_blank: "選択してください" }, class: "app-form-input w-64" %>
    </div>

    <div>
      <%= form.label :city, class: "block" %>
      <%= form.text_field :city, class: "app-form-input" %>
    </div>

    <div>
      <%= form.label :address_line1, class: "block" %>
      <%= form.text_field :address_line1, class: "app-form-input" %>
    </div>

    <div>
      <%= form.label :address_line2, class: "block" %>
      <%= form.text_field :address_line2, class: "app-form-input" %>
    </div>

    <div>
      <%= form.label :phone_number, class: "block" %>
      <%= form.text_field :phone_number, class: "app-form-input" %>
    </div>
  </div>

  <div class="mt-5">
    <%= form.submit class: "app-btn-primary" %>
  </div>
<% end %>
