<div class="app-container-normal">

  <%= render "shared/account/menu" %>

  <h2 class="app-h2">住所更新</h2>

  <%= render "form", user_address: @user_address %>

  <div class="mt-20 text-right">
    <%= button_to "削除", @user_address, method: :delete, class: "app-btn-danger",
    form: { onsubmit: "return confirm('本当に削除しますか？');" } %>
  </div>

</div>
