<div class="swiper-container">
  <div class="swiper app-feature-swiper1">
    <div class="swiper-wrapper">
      <% list.each do |val| %>
        <div class="swiper-slide">
          <img src="<%= val %>" alt="" class="mx-auto" />
        </div>
      <% end %>
    </div>

    <div class="swiper-pagination app-feature-swiper1-pagination"></div>
  </div>
</div>